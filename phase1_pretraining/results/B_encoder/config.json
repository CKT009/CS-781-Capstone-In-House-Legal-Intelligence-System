{
  "name": "B_encoder",
  "arch": "encoder",
  "seed": 1337,
  "vocab_size": 16000,
  "d_model": 768,
  "n_layers": 12,
  "n_heads": 12,
  "n_kv_heads": 12,
  "d_ff": 3072,
  "max_seq_len": 1024,
