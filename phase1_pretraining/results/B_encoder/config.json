  "warmup": 500,
  "max_steps": 40000,
  "schedule": "wsd",
  "decay_frac": 0.2,
  "decay_start": 0,
  "grad_clip": 1.0,
  "amp": "bf16",
  "grad_checkpoint": true,
  "mlm_prob": 0.15,
  "span_rate": 0.15,
  "mean_span": 3,
  "out_dir": "runs",
  "log_every": 20,
  "eval_every": 500,
  "eval_batches": 20,
  "save_every_min": 20,
  "max_minutes": 0,
