{
  "name": "distill",
  "backbone": "../checkpoints/B_grown",
  "ckpt": "best.pt",
  "tokenizer": "artifacts/tokenizer_16k/tokenizer.json",
  "data_dir": "data/Phase_3_RR",
  "out_dir": "runs",
  "domains": [
    "CL",
    "IT"
  ],
  "peft": "adapter",
  "peft_kw": {
    "bottleneck": 64
  },
  "doc_layers": 2,
  "doc_heads": 8,
  "use_crf": true,
  "dropout": 0.1,
  "max_sent_len": 128,
  "max_doc_sents": 256,
  "doc_stride": 64,
  "sent_batch": 32,
  "epochs": 20,
  "lr": 5e-05,
  "head_lr": 0.001,
  "weight_decay": 0.01,
  "warmup_frac": 0.1,
  "grad_clip": 1.0,
  "grad_accum": 2,
  "class_weight": "inv_sqrt",
  "class_weight_cap": 20.0,
  "amp": "bf16",
  "seed": 1337,
  "bootstrap_seed": 0,
  "device": "cuda",
  "log_every": 20,
  "teacher_run": "runs/adapter40",
  "keep_every": 2,
  "alpha": 0.5,
  "temperature": 2.0,
  "control": true,
  "mode": "control"
}